# Optional public HTTPS source repository URL, embedded at build time.
# Leave blank until the real repository is available; never put secrets in VITE_*.
VITE_SOURCE_REPOSITORY_URL=

# Optional public PostHog project token and HTTPS ingestion origin.
# No SDK/autocapture. Missing values, development, localhost, or internal mode disable measurement.
VITE_POSTHOG_PROJECT_TOKEN=
VITE_POSTHOG_HOST=
